# ---------------------------------------------------------------
# Banco do PAINEL (Neon, Supabase ou o Postgres do seu VPS).
# Use a connection string do POOLER quando existir — serverless abre
# muita conexão e o Postgres direto derruba.
# ---------------------------------------------------------------
DATABASE_URL="postgresql://user:senha@host/banco?sslmode=require"

# ---------------------------------------------------------------
# Evolution API rodando no seu VPS (ver infra/docker-compose.yml)
# ---------------------------------------------------------------
EVOLUTION_API_URL="https://evo.seudominio.com.br"
EVOLUTION_API_KEY="troque-esta-chave"

# Segredo que a Evolution manda no header x-webhook-secret.
# Gere com: openssl rand -hex 32
WEBHOOK_SECRET=""

# Protege /api/cron/* (a Vercel manda em Authorization: Bearer)
CRON_SECRET=""

# Assina a sessão do painel
AUTH_SECRET=""

# URL pública do painel, usada pra montar o webhook
APP_URL="https://seu-painel.vercel.app"

TZ_DEFAULT="America/Sao_Paulo"

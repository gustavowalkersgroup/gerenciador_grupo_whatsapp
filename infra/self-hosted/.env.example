# Copie para .env e preencha:  cp .env.example .env
#
# Gere CADA segredo com:  openssl rand -hex 24
# Use hex de propósito: as senhas entram numa URI de conexão e num comando
# SQL, então @ : / # ' quebrariam as duas coisas. Hex nunca quebra.

# ---------------------------------------------------------------- rede ----
# Porta do painel no host. Precisa estar livre; o README mostra como achar
# uma. É para esta porta que o seu Caddy vai fazer reverse_proxy.
PORTA_PAINEL=3000

# Onde essa porta é publicada. 127.0.0.1 = só o próprio host alcança, que é o
# certo quando o Caddy roda nativo na máquina. Se o seu Caddy for container,
# NÃO troque isto por 0.0.0.0 — veja a seção do README, tem jeito melhor.
BIND_PAINEL=127.0.0.1

# ------------------------------------------------------------ segredos ----
# Banco da Evolution (guarda a sessão do WhatsApp).
POSTGRES_PASSWORD=
# Banco do painel.
APP_DB_PASSWORD=
# Chave da API da Evolution: o painel usa para falar com ela.
EVOLUTION_API_KEY=
# A Evolution manda este valor no header ao chamar o webhook do painel.
WEBHOOK_SECRET=
# Protege as rotas de cron contra quem não seja o agendador.
CRON_SECRET=
# Assina a sessão do painel. Trocar este valor desloga todo mundo.
AUTH_SECRET=

# ------------------------------------------------------------ opcionais ---
TZ_DEFAULT=America/Sao_Paulo
SESSION_CLIENT_NAME=Gerenciador
LOG_LEVEL=ERROR,WARN

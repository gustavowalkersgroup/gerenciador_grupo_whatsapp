# Copie para .env e preencha:  cp .env.example .env
#
# Gere CADA segredo com:  openssl rand -hex 24
# Use hex de propósito: as senhas entram numa URI de conexão e num comando
# SQL, então @ : / # ' quebrariam as duas coisas. Hex nunca quebra.

# ---------------------------------------------------------------- rede ----
# As duas variáveis abaixo só valem para quem tem o Caddy NATIVO na máquina e
# sobe com docker-compose.porta-publicada.yml. Com o Caddy em container, o
# painel não publica porta alguma e você pode ignorar as duas.
PORTA_PAINEL=3000
BIND_PAINEL=127.0.0.1

# ------------------------------------------------------------ segredos ----
# Banco da Evolution (guarda a sessão do WhatsApp).
POSTGRES_PASSWORD=
# Banco do painel.
APP_DB_PASSWORD=
# Chave da API da Evolution: o painel usa para falar com ela.
EVOLUTION_API_KEY=
# A Evolution manda este valor no header ao chamar o webhook do painel.
WEBHOOK_SECRET=
# Protege as rotas de cron contra quem não seja o agendador.
CRON_SECRET=
# Assina a sessão do painel. Trocar este valor desloga todo mundo.
AUTH_SECRET=

# ------------------------------------------------- acesso sem domínio -----
# Servidor local acessado por IP, em HTTP puro? Descomente a linha abaixo.
#
# O cookie de sessão sai com a flag `Secure` por padrão, e navegador nenhum
# guarda cookie `Secure` vindo de HTTP. Sem isto o login falha de um jeito
# traiçoeiro: some a tela de login e você volta para ela, como se a senha
# estivesse errada.
#
# O preço: o cookie de sessão trafega em texto claro na rede local. Quem
# conseguir capturar o tráfego assume a sessão. Aceitável em rede confiável
# com máquinas conhecidas; não use em Wi-Fi compartilhado. O README mostra a
# alternativa com HTTPS de verdade, sem domínio.
#COOKIE_SECURE=false

# ------------------------------------------------------------ opcionais ---
TZ_DEFAULT=America/Sao_Paulo
SESSION_CLIENT_NAME=Gerenciador
LOG_LEVEL=ERROR,WARN

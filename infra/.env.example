# Domínio que aponta (registro A) para o IP do VPS.
EVOLUTION_DOMAIN=evo.seudominio.com.br
EVOLUTION_PUBLIC_URL=https://evo.seudominio.com.br

# Chave mestra da Evolution API. É o mesmo valor de EVOLUTION_API_KEY na Vercel.
# Gere com: openssl rand -hex 32
EVOLUTION_API_KEY=

# Senha do Postgres interno da Evolution (não é o banco do painel).
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Nome que aparece em "Aparelhos conectados" no celular.
SESSION_CLIENT_NAME=Gerenciador

LOG_LEVEL=ERROR,WARN
